# Example environment variables — copy to .env and fill locally.
# Never commit a real .env file.

# USDA FoodData Central (optional; bulk CSVs also work without API)
USDA_API_KEY=

# Neo4j (admin load only — public demo should use the read-only user)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional: read-only Bolt credentials for local frontend testing
# NEO4J_READONLY_USER=readonly
# NEO4J_READONLY_PASSWORD=
